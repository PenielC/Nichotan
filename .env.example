# Nichotan API configuration, as environment variables (names only — never commit real values).
# ASP.NET Core reads nested settings with a double underscore: Jwt__Secret sets Jwt:Secret.
# Local development needs none of these: backend/src/Nichotan.Api/appsettings.Development.json
# points at the Docker Compose services. Set them on servers through the host's secret store.

ASPNETCORE_ENVIRONMENT=

# PostgreSQL
ConnectionStrings__Database=

# Access tokens: a random secret of at least 32 characters
Jwt__Secret=
Jwt__Issuer=
Jwt__Audience=
Jwt__AccessTokenMinutes=
Session__RefreshTokenDays=

# Staff must use an authenticator app (keep true outside local development)
Security__RequireMfaForStaff=

# The web app's public address, used in email links, and the origins allowed to call the API
App__WebBaseUrl=
Cors__AllowedOrigins__0=

# Outgoing email
Smtp__Host=
Smtp__Port=
Smtp__EnableSsl=
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=

# Private S3-compatible document storage
Storage__ServiceUrl=
Storage__Region=
Storage__Bucket=
Storage__AccessKey=
Storage__SecretKey=
Storage__ForcePathStyle=
Storage__CreateBucketIfMissing=

# First start: apply migrations, and create the first administrator if no administrator exists yet.
# Remove the admin password once that account has signed in and changed it.
Bootstrap__MigrateOnStartup=
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=
Bootstrap__AdminFirstName=
Bootstrap__AdminLastName=

# Per-IP limits on sign-in forms and on endpoints that send email
RateLimits__AuthPerMinute=
RateLimits__EmailPer15Minutes=
