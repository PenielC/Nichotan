{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Jwt": {
    "Issuer": "Nichotan",
    "Audience": "Nichotan",
    "Secret": "",
    "AccessTokenMinutes": 15
  },
  "Session": {
    "RefreshTokenDays": 14
  },
  "Admissions": {
    "NotifyEmail": "enquiries@nichotan.com"
  },
  "Reminders": {
    "Enabled": true,
    "RunEveryMinutes": 15,
    "TimeZone": "UTC",
    "DigestTime": "08:00",
    "BiometricsFirstAfterDays": 3,
    "BiometricsRepeatEveryDays": 5,
    "BiometricsMaxReminders": 3
  },
  "Enquiries": {
    "NotifyEmail": "enquiries@nichotan.com"
  },
  "Security": {
    "RequireMfaForStaff": true
  },
  "App": {
    "WebBaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "FromAddress": "",
    "FromName": "Nichotan"
  },
  "Storage": {
    "ServiceUrl": "",
    "Region": "us-east-1",
    "Bucket": "nichotan-documents",
    "ForcePathStyle": true,
    "CreateBucketIfMissing": false
  },
  "Bootstrap": {
    "MigrateOnStartup": false
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "EmailPer15Minutes": 5
  }
}
