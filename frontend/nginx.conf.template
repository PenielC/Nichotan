# One public origin for the web app and the API, so the sign-in cookie stays same-site (see ADR 0002).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Uploads are up to 10 MB each; leave headroom for the multipart envelope.
    client_max_body_size 12m;

    location /api/ {
        proxy_pass ${API_SCHEME}://${API_HOST};
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_HOST};
        # The platform ingress in front of nginx already put the real client address in X-Forwarded-For; pass it on untouched.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 60s;
    }

    # Hashed build assets never change: cache them hard.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths serve the shell, which does its own routing. Never cache the shell.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }
}
